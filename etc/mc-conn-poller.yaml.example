# mc-conn-poller configuration — template.
# Copy to /usr/local/etc/mc-conn-poller.yaml and edit.
#
# Targets are YAML-only — no CLI flag or MCCP_ env var overrides a target
# list, since a list of structs has no sane single-flag representation.

# Poll interval used for any target that doesn't set its own "interval".
#default_interval: 60s

# Probe timeout used for any target that doesn't set its own "timeout".
#default_timeout: 5s

# "debug", "info", "warn", or "error".
#log_level: info

# Send logs to syslog (facility daemon) instead of stderr.
#log_syslog: false

targets:
  - name: proxy-java
    protocol: java
    host: play.example.com
    port: 25565
    # interval: 60s        # optional, overrides default_interval
    # timeout: 5s          # optional, overrides default_timeout
    # ip_family: alternate # optional: ipv4, ipv6, or alternate (default)
    ping_url: https://hc-ping.com/00000000-0000-0000-0000-000000000000

  - name: proxy-bedrock
    protocol: bedrock
    host: play.example.com
    port: 19132
    ping_url: https://hc-ping.com/11111111-1111-1111-1111-111111111111

  # To alert on IPv4 and IPv6 independently, pin every target for the same
  # host to one family, each with its own Healthchecks.io check. Both must be
  # pinned: an "alternate" target keeps pinging its check on successful IPv6
  # rounds even during an IPv4 outage, which would hide that outage. So:
  #   1. set "ip_family: ipv4" on proxy-java above, and
  #   2. add a second target for IPv6 with its own check:
  #
  # - name: proxy-java-v6
  #   protocol: java
  #   host: play.example.com
  #   port: 25565
  #   ip_family: ipv6
  #   ping_url: https://hc-ping.com/22222222-2222-2222-2222-222222222222
