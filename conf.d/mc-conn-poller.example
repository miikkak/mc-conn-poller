# OpenRC service configuration for mc-conn-poller — template.
# Copy to /etc/conf.d/mc-conn-poller and edit as needed.
#
# These variables control how init.d/mc-conn-poller runs the daemon (binary
# path, user/group, logging). The daemon's own settings (targets, intervals,
# ping URLs) live in a separate YAML file — see
# etc/mc-conn-poller.yaml.example.

# Path to the compiled binary.
#MCCP_BINARY="/usr/local/sbin/mc-conn-poller"

# Path to the daemon's YAML config file.
#MCCP_CONFIG="/usr/local/etc/mc-conn-poller.yaml"

# Directory for the daemon's log file.
#MCCP_LOG_DIR="/var/log/mc-conn-poller"

# User/group to run the daemon as. Needs only outbound network access — no
# special filesystem permissions beyond reading MCCP_CONFIG.
#MCCP_USER="mc-conn-poller"
#MCCP_GROUP="mc-conn-poller"
